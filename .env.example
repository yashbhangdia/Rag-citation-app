# ─────────────────────────────────────────────
#  RAG Citation App — Environment Configuration
# ─────────────────────────────────────────────

# ── HuggingFace ──────────────────────────────
# Get your free token at: https://huggingface.co/settings/tokens
# Free tier: Unlimited inference on public models
HUGGINGFACE_API_TOKEN=hf_your_token_here

# ── Embedding Model (runs 100% locally, no API needed) ──
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# ── LLM via HuggingFace Inference API (free) ──
# Options (all free on HF):
#   mistralai/Mistral-7B-Instruct-v0.3
#   meta-llama/Meta-Llama-3-8B-Instruct  (need HF approval)
#   HuggingFaceH4/zephyr-7b-beta          (no approval needed)
#   microsoft/Phi-3-mini-4k-instruct      (no approval needed)
LLM_MODEL=HuggingFaceH4/zephyr-7b-beta

# ── Vector Database ───────────────────────────
CHROMA_PERSIST_DIR=./data/chroma_db
COLLECTION_NAME=rag_documents

# ── RAG Configuration ─────────────────────────
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K_RESULTS=5
MAX_NEW_TOKENS=1024

# ── App Configuration ─────────────────────────
APP_TITLE=RAG Citation Assistant
APP_PORT=8501
LOG_LEVEL=INFO
