# ── LLM (free) ───────────────────────────────────────────────────────────────
# transformers : open model run in-process on a GPU (Colab T4). No key needed.
# hf_api       : HuggingFace Inference Providers (needs a free token below).
LLM_BACKEND=transformers
LOCAL_LLM_MODEL=Qwen/Qwen2.5-3B-Instruct   # ~6 GB download; Qwen/Qwen2.5-7B-Instruct is stronger but ~15 GB
LOCAL_LLM_MODEL_SMALL=Qwen/Qwen2.5-1.5B-Instruct   # used when no CUDA GPU

# hf_api backend only
LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct   # must be served by a provider enabled on your HF account
HUGGINGFACEHUB_API_TOKEN=hf_your_token_here   # https://huggingface.co/settings/tokens

# ── Retrieval models ─────────────────────────────────────────────────────────
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
DEVICE=auto

# ── Index / RAG ──────────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=./data/chroma_db
COLLECTION_NAME=rag_documents
DOCUMENTS_DIR=./data/documents
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K_RESULTS=5
RETRIEVAL_CANDIDATES=20
MAX_NEW_TOKENS=1024
MIN_SUPPORT_SCORE=-2.0

APP_TITLE=FinSight AI
LOG_LEVEL=INFO
